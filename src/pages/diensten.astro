---
import Layout from '../layouts/Layout.astro';
import { sitePath } from '../lib/urls';
---
<Layout title="Diensten" description="Websites, digitale werkstromen en controleerbare productontwikkeling door Raderwerk."><section class="hero"><p class="eyebrow">Diensten</p><h1>Van informatie naar werkend systeem.</h1><p class="lead">We bouwen afgebakende digitale producten. De aanpak, bron en status blijven zichtbaar tijdens het werk.</p></section><section class="section"><div class="grid"><article class="card"><h2>Websites</h2><p>Snelle statische sites, catalogi en contentlagen die redacteuren kunnen beheren.</p></article><article class="card"><h2>Werkstromen</h2><p>Koppelingen en aanvraagflows met expliciete foutafhandeling en menselijke controle.</p></article><article class="card"><h2>Prototypes</h2><p>Testbare previews om aannames vroeg te controleren voordat publicatie aan de orde is.</p></article><article class="card"><h2>Bewijs</h2><p>Tests, reviews en meetresultaten horen bij de oplevering, niet bij de bijsluiter.</p></article></div><div class="actions"><a class="button" href={sitePath('contact/')}>Bespreek wat nodig is</a><a href={sitePath('cases/')}>Bekijk lopend werk</a></div></section></Layout>
