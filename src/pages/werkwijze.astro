import Layout from '../layouts/Layout.astro';
import { sitePath } from '../lib/urls';
---
<Layout title="Werkwijze" description="De stappen en vier menselijke poorten in de werkwijze van Raderwerk." primaryHref={sitePath('contact/')} primaryLabel="Leg een vraag voor"><section class="hero"><p class="eyebrow">Werkwijze</p><h1>Agents voeren uit. Mensen besluiten.</h1><p class="lead">Het werk beweegt in kleine, zichtbare stappen. Bij elk controlepunt ligt bewijs klaar en bepaalt een mens of het verdergaat.</p></section><section class="section alt"><div class="prose"><h2>Vier menselijke poorten</h2><ol class="steps"><li><strong>Poort 1 — voorstel.</strong> Een mens bepaalt of het voorstel verstuurd wordt en het project start.</li><li><strong>Poort merge — merge of publicatie.</strong> Een mens merget de pull request of publiceert het werk.</li><li><strong>Poort 2 — oplevering.</strong> Een mens bepaalt of het werk is opgeleverd en het opleverbericht verstuurd mag worden.</li><li><strong>Poort 3 — factuur.</strong> Een mens bepaalt of het factuurconcept verstuurd mag worden.</li></ol><p>Agents openen geen poort en voeren de onomkeerbare handeling niet uit. Bij iedere poort kan de bevoegde mens goedkeuren, afwijzen of om aanpassing vragen.</p><a class="button" href={sitePath('contact/')}>Bespreek een opdracht</a></div></section></Layout>
