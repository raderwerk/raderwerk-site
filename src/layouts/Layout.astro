---
import { sitePath } from '../lib/urls';
interface Props { title: string; description: string; primaryHref?: string; primaryLabel?: string; fictitious?: boolean; }
const { title, description, primaryHref = sitePath('contact/'), primaryLabel = 'Bespreek een opdracht', fictitious = false } = Astro.props;
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const links = [['','Home'],['werkwijze/','Werkwijze'],['diensten/','Diensten'],['cases/','Cases'],['transparantie/','Transparantie'],['contact/','Contact']];
---
<!doctype html><html lang="nl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><meta name="description" content={description}><link rel="icon" href={sitePath('favicon.svg')}><title>{title} · Raderwerk</title></head>
<body><a class="skip" href="#inhoud">Naar de inhoud</a><header><a class="brand" href={sitePath()} aria-label="Raderwerk, naar home"><span aria-hidden="true">RW</span> Raderwerk</a><nav aria-label="Hoofdnavigatie">{links.map(([href,label]) => { const url=sitePath(href); const current=path === url || (href === 'cases/' && path.startsWith(url)); return <a href={url} aria-current={current ? 'page' : undefined}>{label}</a>})}</nav><a class="button compact" href={primaryHref}>{primaryLabel}</a></header>
<main id="inhoud"><slot /></main><footer><div><a class="brand inverse" href={sitePath()}>Raderwerk</a><p>Every part turns the next.</p><p>Deze publieke tekst is geschreven met AI. Lees welke modellen en menselijke poorten we gebruiken op de <a href={sitePath('transparantie/')}>transparantiepagina</a>.</p></div><nav aria-label="Voettekst"><a href={sitePath('werkwijze/')}>Werkwijze</a><a href={sitePath('cases/')}>Cases</a><a href={sitePath('transparantie/')}>Transparantie</a><a href={sitePath('contact/')}>Contact</a></nav>{fictitious && <p class="notice">Demonstratiebedrijf van Raderwerk. Dit bedrijf bestaat niet.</p>}</footer></body></html>
<style is:global>
:root{--ink:#14231e;--paper:#f4f0e7;--white:#fffefa;--accent:#b64a2b;--green:#254f41;--line:#b7b4aa;--focus:#1b63a8;font-family:Arial,sans-serif;color:var(--ink);background:var(--paper)}*{box-sizing:border-box}body{margin:0;line-height:1.6}a{color:inherit;text-underline-offset:.2em}a:focus-visible,button:focus-visible{outline:3px solid var(--focus);outline-offset:4px}.skip{position:absolute;left:-9999px}.skip:focus{left:1rem;top:1rem;background:white;padding:.6rem;z-index:3}header{min-height:76px;display:flex;align-items:center;gap:2rem;padding:1rem max(5vw,1rem);border-bottom:1px solid var(--line);background:var(--white)}.brand{font-size:1.1rem;font-weight:800;text-decoration:none;margin-right:auto}.brand span{display:inline-grid;place-items:center;width:2.4rem;height:2.4rem;border:2px solid;border-radius:50%;margin-right:.5rem}nav{display:flex;gap:1.5rem}nav a{text-decoration:none}nav a[aria-current=page]{text-decoration:underline;text-decoration-thickness:2px}.button{display:inline-block;background:var(--accent);color:white;font-weight:700;text-decoration:none;padding:.8rem 1.1rem;border-radius:2px}.compact{white-space:nowrap}.hero{padding:clamp(4rem,10vw,9rem) max(5vw,1rem);max-width:1100px}.eyebrow{text-transform:uppercase;letter-spacing:.12em;font-size:.78rem;font-weight:800;color:var(--accent)}h1{font:700 clamp(2.8rem,7vw,6rem)/.98 Georgia,serif;max-width:900px;margin:.3em 0}h2{font:700 clamp(2rem,4vw,3.5rem)/1.1 Georgia,serif}h3{font-size:1.25rem}.lead{font-size:clamp(1.15rem,2vw,1.45rem);max-width:720px}.actions{display:flex;gap:1rem;align-items:center;margin-top:2rem}.section{padding:clamp(3rem,7vw,6rem) max(5vw,1rem)}.section.alt{--focus:#f2c94c;background:var(--green);color:white}.section.alt .eyebrow,.section.alt .steps li:before{color:white}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.5rem}.card{--focus:#1b63a8;background:var(--white);color:var(--ink);padding:clamp(1.5rem,4vw,3rem);border-top:4px solid var(--accent)}.card a{font-weight:700}.meta{display:flex;gap:.7rem;flex-wrap:wrap}.tag{border:1px solid currentColor;border-radius:99px;padding:.2rem .7rem;font-size:.85rem}.prose{max-width:760px}.steps{counter-reset:step;list-style:none;padding:0}.steps li{counter-increment:step;border-top:1px solid var(--line);padding:1.5rem 0}.steps li:before{content:'0' counter(step);color:var(--accent);font-weight:bold;margin-right:1rem}footer{--focus:#f2c94c;padding:3rem max(5vw,1rem);background:var(--ink);color:white;display:grid;grid-template-columns:1fr auto;gap:2rem}footer>div{max-width:46rem}.notice{grid-column:1/-1;border-top:1px solid #87938e;padding-top:1rem;font-weight:700}@media(max-width:900px){header{flex-wrap:wrap;gap:.8rem}header nav{order:3;width:100%;overflow:auto;gap:1rem}.compact{display:none}.grid{grid-template-columns:1fr}.actions{align-items:flex-start;flex-direction:column}footer{grid-template-columns:1fr}footer nav{flex-wrap:wrap}}
</style>
