---
import Layout from '../layouts/Layout.astro';
import { sitePath } from '../lib/urls';
interface Props { name:string; intro:string; assignment:string; approach:string[]; screenshot:string; screenshotAlt:string; preview?:string; }
const {name,intro,assignment,approach,screenshot,screenshotAlt,preview}=Astro.props;
---
<Layout title={`${name} — lopende case`} description={`Lopende opdracht voor ${name}: klant, opdracht en aanpak.`} fictitious={name !== 'Raderwerk'} primaryHref={preview ?? sitePath('contact/')} primaryLabel={preview ? 'Bekijk de preview' : 'Neem contact op'}>
<section class="hero"><p class="eyebrow">Lopende opdracht{name !== 'Raderwerk' && ' · demonstratiecase'}</p><h1>{name}</h1>{name !== 'Raderwerk' && <p class="notice-inline">Demonstratiebedrijf van Raderwerk. Dit bedrijf bestaat niet.</p>}<p class="lead">{intro}</p><div class="actions">{preview ? <a class="button" href={preview}>Bekijk de preview</a> : <span class="tag">Preview in aanbouw</span>}<a href={sitePath('cases/')}>Terug naar alle cases</a></div></section>
<figure class="case-shot"><img src={sitePath(screenshot)} alt={screenshotAlt} width="1440" height="900" loading="eager" decoding="async" /><figcaption>{preview ? `Schermafbeelding van de huidige ${name}-preview.` : `De projectpreview voor ${name} is nog in aanbouw; dit is de huidige publieke casepagina.`}</figcaption></figure>
<section class="section alt"><div class="prose"><p class="eyebrow">De opdracht</p><h2>Wat er moet veranderen</h2><p class="lead">{assignment}</p></div></section>
<section class="section"><div class="prose"><p class="eyebrow">De aanpak</p><h2>Werk dat nu loopt</h2><ol class="steps">{approach.map(item=><li>{item}</li>)}</ol><p>Dit is werk in uitvoering. We publiceren geen resultaten voordat ze gemeten en gecontroleerd zijn.</p></div></section>
</Layout>
<style>.notice-inline{font-weight:700;max-width:720px}.case-shot{margin:0;padding:0 max(5vw,1rem) clamp(3rem,7vw,6rem);max-width:1440px}.case-shot img{display:block;width:100%;height:auto;border:1px solid var(--line);box-shadow:0 1rem 3rem #14231e26}.case-shot figcaption{margin-top:.75rem;font-size:.9rem}</style>
